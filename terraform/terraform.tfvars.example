# Example Terraform variables file
# Copy this to terraform.tfvars and fill in your values

project_id = "autoapply-prod-123456"  # Your GCP project ID
region     = "us-central1"
zone       = "us-central1-a"
environment = "prod"

# API Keys (store these securely!)
openai_api_key       = "sk-..."
supabase_url         = "https://xxxxx.supabase.co"
supabase_service_key = "eyJ..."
github_client_id     = "Iv1.xxx"
github_client_secret = "xxx"

# Scaling (adjust based on needs)
min_instances            = 0    # Scale to zero when not in use
max_instances            = 10   # Limit for cost control
max_concurrent_requests  = 80

# Database
database_tier      = "db-f1-micro"  # ~$7/month
database_disk_size = 10
redis_memory_size  = 1  # 1GB Redis

# Monitoring
alert_email = "your-email@example.com"

# Features
enable_redis       = true
enable_cloud_sql   = false  # Use Supabase instead
enable_cloud_tasks = true