# ============================================
# Railway Environment Variables Template
# ============================================
# Copy these to each Railway service's environment variables
# via the Railway dashboard: Settings > Variables

# ============================================
# REQUIRED FOR ALL SERVICES
# ============================================

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-openai-api-key

# Supabase Configuration (get from https://supabase.com/dashboard/project/_/settings/api)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# FRONTEND SERVICE ONLY
# ============================================

# Supabase public key (safe to expose in browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# API URLs (set after deploying backend services)
VITE_API_BASE_URL=https://your-main-api.railway.app
VITE_CV_API_URL=https://your-cv-api.railway.app
VITE_APPLICATION_AGENT_URL=https://your-app-agent.railway.app

# GitHub OAuth (create at https://github.com/settings/developers)
VITE_GITHUB_CLIENT_ID=your-github-client-id

# ============================================
# MAIN API SERVICE ONLY
# ============================================

# GitHub OAuth Secret (server-side only, never expose)
GITHUB_CLIENT_SECRET=your-github-client-secret

# ============================================
# CELERY SERVICES (Worker & Beat)
# ============================================

# Redis URL - Railway provides this automatically when you add Redis
# Format: redis://default:password@host:port
CELERY_BROKER_URL=${{Redis.REDIS_URL}}
CELERY_RESULT_BACKEND=${{Redis.REDIS_URL}}

# Alternative if using custom Redis
# CELERY_BROKER_URL=redis://default:password@your-redis-host:6379/0
# CELERY_RESULT_BACKEND=redis://default:password@your-redis-host:6379/1

# ============================================
# APPLICATION AGENT SERVICE
# ============================================

# Internal service URL for CV API (use Railway's internal networking)
CV_API_URL=http://cv-api.railway.internal:8001

# ============================================
# OPTIONAL CONFIGURATION
# ============================================

# Logging level
LOG_LEVEL=INFO

# Demo mode (disable in production)
DEMO_MODE=false

# LLM Configuration
DEFAULT_LLM_MODEL=gpt-4o
VISION_MODEL=gpt-4o
CHEAP_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4000

# Tavily Search API (optional alternative to OpenAI web search)
# TAVILY_API_KEY=your-tavily-key
